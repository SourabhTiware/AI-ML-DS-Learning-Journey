# Scatter Plots
people = ["Person A", "Person B", "Person C", "Person D", "Person E", 
          "Person F", "Person G", "Person H", "Person I", "Person J"]
age = [22, 25, 30, 35, 40, 45, 50, 55, 60, 65]
bp = [110, 115, 120, 122, 125, 130, 135, 123, 145, 150]

plt.scatter(age, bp)
# plt.grid()

plt.title("Age Vs Blood Pressure")
plt.xlabel("Age")
plt.ylabel("Blood Pressure")
plt.tight_layout()





# customizing plots

colors = ["green" if i < 135 else "red" for i in bp]
size= bp
# plt.scatter(age,bp, color = colors, s= size, marker="o", alpha=0.6, cmap="plasma")
plt.scatter(age,bp, color = colors, s= size, marker="o", alpha=0.6, cmap="OrRd")
plt.colorbar(label="BP")
plt.grid

# add annotation 
for i in range(len(age)):
    plt.annotate(people[i], xy=(age[i], bp[i]), xytext=(age[i]+1, bp[i]+2))

plt.xlim(min(age)-5, max(age)+10)
plt.ylim(min(bp)-5, max(bp)+5)





