


import numpy as np
import matplotlib.pyplot as plt


np.random.seed(0)
scores = np.random.normal(loc=70, scale=10, size=100)

plt.hist(scores, bins=5, color="skyblue", edgecolor="black")
plt.title("Distribution of exam scores")
plt.xlabel("marks")
plt.ylabel("number of student's")
plt.tight_layout()





# custom 
marks = [
    25, 38, 42, 55, 61, 67, 72, 78, 83, 88,
    91, 95, 47, 53, 59, 64, 69, 74, 79, 85,
    92, 97, 33, 45, 58, 62, 71, 76, 81, 89
]

bins = [0, 30, 70, 90, 100]

plt.hist(
    marks,
    bins=bins,
    edgecolor="black",
    color="lightblue"
)

plt.xlabel("marks")
plt.ylabel("number of students")
plt.title("Distribution of marks of 30 students")
plt.grid()





# axv line
marks = [
    25, 38, 42, 55, 61, 67, 72, 78, 83, 88,
    91, 95, 47, 53, 59, 64, 69, 74, 79, 85,
    92, 97, 33, 45, 58, 62, 71, 76, 81, 89
]

# custom bins
bins = [0, 30, 70, 90, 100]

plt.hist(
    marks,
    edgecolor="black",
    bins=bins,
    color="lightblue"
)

plt.axvline(
    x=33, # passing line, average, mean of data can set "x" value
    color="red",
    linestyle="--",
    linewidth=2,
    label="Pass marks (33)"
)

plt.xlabel("marks")
plt.ylabel("Number of students")
plt.title("Distribution of marks of 30 students")
plt.grid(True)


# Multiple datasets
